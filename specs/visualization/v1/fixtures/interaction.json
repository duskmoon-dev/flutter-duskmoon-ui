{
  "line-controlled-selection-and-reset": {
    "chart": {
      "kind": "line",
      "xAxis": {"type": "numeric"},
      "yAxis": {"type": "numeric", "unit": "°C"},
      "series": [
        {
          "id": "a",
          "name": "a",
          "data": [
            {"id": "first", "x": 2, "y": 0},
            {"id": "gap", "x": 0, "y": null},
            {"id": "second", "x": 2, "y": 5},
            {"id": "last", "x": 1, "y": 10}
          ]
        }
      ],
      "options": {"selectionMode": "multiple"}
    },
    "actions": [
      {
        "type": "focus",
        "target": {"kind": "datum", "seriesId": "a", "datumId": "first"}
