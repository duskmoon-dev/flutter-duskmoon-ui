      {
        "type": "activate",
        "target": {"kind": "datum", "seriesId": "a", "datumId": "first"}
      },
      {
        "type": "writeSelection",
        "ids": [
          {"kind": "datum", "seriesId": "a", "datumId": "first"}
        ]
      },
      {
        "type": "activate",
        "target": {"kind": "datum", "seriesId": "a", "datumId": "first"}
      },
      {
        "type": "writeSelection",
        "ids": []
