      {
        "type": "activate",
        "target": {"kind": "datum", "seriesId": "a", "datumId": "second"}
      },
      {
        "type": "writeSelection",
        "ids": [
          {"kind": "datum", "seriesId": "a", "datumId": "second"}
        ]
      },
      {"type": "toggleSeries", "seriesId": "a"},
      {
        "type": "zoom",
        "viewport": {
          "kind": "line",
          "x": [1.5, 2]
        }
      },
      {
        "type": "brush",
        "range": [1.6, 1.9]
      },
      {"type": "cancel"},
      {"type": "reset"},
      {
        "type": "writeSelection",
        "ids": []
      }
    ],
    "controlled": ["selection"]
  },
